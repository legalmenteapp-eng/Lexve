# --- Supabase (Dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://ubcqgcgyjslrrewhrjrn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_6TT0YGTCNETiXghlhnHQAw_CGXwJaQO
# Solo servidor: necesaria para el cron de alertas (nunca la expongas en el navegador)
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (análisis de casos, documentos y sentencias; búsqueda en el TSJ) ---
ANTHROPIC_API_KEY=
# Modelo por defecto: claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5

# --- Google Drive (cuenta de servicio con acceso de lectura a las carpetas de los clientes) ---
# Pega el JSON completo de la cuenta de servicio en una sola línea
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Correo de alertas (Resend) ---
RESEND_API_KEY=
ALERTAS_REMITENTE="LexVE Alertas <alertas@tu-dominio.com>"
# Mientras sea distinto de "true" los correos se registran como "simulado" y NO se envían
ALERTAS_ENVIO_REAL=false
# Secreto largo y aleatorio. Protege /api/cron/alertas y la función de IA en segundo plano de Netlify
CRON_SECRET=

# En Netlify: la URL pública del sitio, p. ej. https://lexve.netlify.app (enlaces de los correos)
NEXT_PUBLIC_APP_URL=http://localhost:3000
